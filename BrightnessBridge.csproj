<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>BrightnessBridge</AssemblyName>
    <RootNamespace>BrightnessBridge</RootNamespace>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Product>BrightnessBridge</Product>
    <Description>Forwards the Windows brightness setting to external monitors over DDC/CI</Description>
    <Copyright>Copyright (c) 2026 Nikolay Bryskin</Copyright>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BrightnessBridge.cs" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
